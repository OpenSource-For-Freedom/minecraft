# Secrets - never commit (public repo)
.env
.env.*

# Runtime state the SERVER rewrites on every boot. These must not be tracked:
# while they are, `git pull --ff-only` on the droplet aborts every single time
# because the worktree is permanently dirty, which blocks automated deploys.
# docker-compose.yml env vars are the source of truth for settings and rosters.
data/server.properties
data/whitelist.json
data/ops.json
data/banned-players.json
data/banned-ips.json
data/usercache.json
data/bluemap/
data/config/
data/.forge-manifest.json
data/.run-forge.env
data/kubejs/*/generated/
data/crash-reports/
data/local/
# data/.local/ with the dot is what the container actually creates (HOME=/tmp
# does not stop it). The rule above, without the dot, never matched it. Found by
# running the stack locally on 2026-09-12: both this and user_jvm_args.txt below
# showed up as untracked, which on the droplet is precisely what makes
# `git pull --ff-only` abort and blocks the gitops deploy.
data/.local/
# Written by the Forge installer at every container start, from MEMORY and the
# sqlite JVM flags in docker-compose.yml. Generated, never authored.
data/user_jvm_args.txt
data/log4j2.xml
data/rhino.local.properties
data/run.bat
data/run.sh
data/kubejs/README.txt
data/kubejs/config/common.properties
data/kubejs/server_scripts/example.js
data/kubejs/startup_scripts/

# Spark profiler temp files
data/config/spark/tmp/

# World saves (large binary data)
data/world/
data/world_nether/
data/world_the_end/

# Server JARs and runtime libraries
data/*.jar
data/libraries/
data/.fabric/
data/.fabric-manifest.json
data/.install-fabric.env
data/.modrinth-manifest.json
data/.rcon-cli.env
data/.rcon-cli.yaml
data/.cache/
data/versions/

# Logs
data/logs/

# Mod JARs (binary)
data/mods/

# The Windows-era local server, abandoned when the game moved to the droplet.
# Untracked 2026-09-12. Nothing in this repo referenced it, and its
# server.properties actively contradicted the live config: it said
# white-list=false and view-distance=8 while docker-compose.yml enforces the
# whitelist and runs view-distance 12. A dead config file that disagrees with
# the running one is worse than no file, because it reads as documentation.
# docker-compose.yml env vars are the only source of truth for settings.
# The directory is left on disk (it holds a 58 MB server.jar) but never tracked.
server/

# Python bytecode. A .pyc for .github/scripts/server_health.py was tracked for
# months because there was no rule here at all.
__pycache__/
*.pyc

# tools/sync_client_pack.py --write leaves EduCraftClient.mrpack.bak beside the
# pack, which git then offers to commit next to the real thing. Two files with
# near-identical names and different mod sets is exactly the trap that
# EduCraftClientServer.mrpack was.
*.bak

# Backups (large zips)
backup/
