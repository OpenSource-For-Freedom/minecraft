# Spark profiler temp files
data/config/spark/tmp/

# World saves (large binary data), except the Questify (mod id "questory",
# lowercase - confirmed from its compiled class, LevelResource.ROOT.resolve("data").resolve("questory"))
# quest definitions, which are plain JSON and need to travel with the repo like any other config.
data/world/*
!data/world/data/
data/world/data/*
!data/world/data/questory/
data/world_nether/
data/world_the_end/

# Server JARs and runtime libraries
data/*.jar
data/libraries/
data/.fabric/
data/.fabric-manifest.json
data/.install-fabric.env
data/.modrinth-manifest.json
data/.rcon-cli.env
data/.rcon-cli.yaml
data/.cache/
data/versions/

# Logs
data/logs/

# Mod JARs (binary)
data/mods/

# Server folder JARs and logs
server/*.jar
server/*.log

# Backups (large zips)
backup/
