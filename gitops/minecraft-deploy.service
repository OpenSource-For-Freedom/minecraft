[Unit]
Description=Deploy the Minecraft server from GitHub if main moved
After=docker.service network-online.target
Wants=network-online.target

[Service]
Type=oneshot
# Optional: supplies GH_DEPLOY_TOKEN for GitHub Deployments reporting. The
# leading dash makes it non-fatal when absent, so deploys work with no token.
EnvironmentFile=-/etc/minecraft-deploy.env
ExecStart=/root/minecraft/gitops/deploy.sh
# One deploy at a time; a slow rebuild must not overlap the next timer tick.
TimeoutStartSec=1800

# The script needs root (docker, chown), but nothing beyond this repo and docker.
PrivateTmp=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictSUIDSGID=true
NoNewPrivileges=true
